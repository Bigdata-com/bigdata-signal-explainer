# Users sign in with their own Bigdata API key. This one is optional: runs created before sign-in existed
# are given to the user who owns it.
BIGDATA_API_KEY=
OPENAI_API_KEY=
# GPT-6 family on this account: gpt-6-sol, gpt-6-luna, gpt-6-astra, gpt-6.1-sol
OPENAI_MODEL=gpt-6-sol
DB_PATH=./data/app.db
# Encrypts the sign-in cookie. Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty and everyone signs in again after each restart.
APP_SECRET=
# True for HTTPS deployments (browsers also accept it on http://localhost).
COOKIE_SECURE=true
